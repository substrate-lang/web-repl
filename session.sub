;; The REPL's compiler half, which the page runs as a worker. Each input arrives as a message of a four-byte id and
;; the text, and each answer is a byte, 1 for a failure, followed by the error.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified rt compiler/roots)
(require-unqualified worker host/worker)
(require-unqualified events host/events)

(provide session-serve!)

(define input buffer)

(define evaluating bool #f)

(define (session-serve!)
  (set! input (make-buffer))
  (event-handler! worker-source on-message)
  (trap-handler! session-trapped)
  (set-toolchain-directory! `"/src/substrate")
  (install-core!)
  (set-module-map-text! `"(uses (std std) (scheme scheme) (bend bend)) (root std \"/src/std\")
                          (root scheme \"/src/packages/scheme\" (uses (nodes nodes)))
                          (root bend \"/src/packages/bend\" (uses (nodes nodes))) (root nodes \"/src/packages/nodes\")"
                        `"the REPL")
  (session-open! `"repl"))

(define (reply! [failed bool] [error datum])
  (let ([b (make-buffer)])
    (buffer-add-byte! (& b) failed)
    (when (!= error 0) (buffer-add-string! (& b) (datum->string error)))
    (worker-send 0 (buffer-bytes (& b)))
    (buffer-free! (& b))))

(define (on-message [s u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message)
    (set! (-> input length) 0)
    (when (>= (events-take! (& input)) 4)
      (let* ([id (@ (cast (ptr u32) (-> input bytes)))]
             [source (format "input-~a" (cons (make-integer id) nil))]
             [text (string->datum (slice (buffer-string (& input)) 4))])
        (set! evaluating #t)
        (let ([succeeded (session-eval-text! text source)])
          (set! evaluating #f)
          (reply! (not succeeded) (if succeeded 0 (session-error))))))))

(define (session-trapped [why string])
  (when evaluating
    (set! evaluating #f)
    (reply! #t (trap-report why))
    (session-recover!)))
