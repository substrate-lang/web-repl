;; The REPL as a component: the half the user sees.
(require-unqualified web-ui)
(require-unqualified host/worker)
(require-unqualified "session.sub")
(require-unqualified host/stream)
(require-unqualified host/web/storage)
(require-unqualified host/web/clipboard)
(require-unqualified host/web/files)
(require-unqualified std/string)

(provide repl repl-event language-changed)

;; ---- data ----

(struct entry [id u32] [input string] [output buffer] [failed bool] [running bool] [cut bool])

(struct history-item [id u32] [input string])

(struct model
  [entries (ptr entry)] [count u32] [capacity u32]
  [draft string]
  [inputs u32]
  [focus u32] [scroll u32]
  [recalled u32]
  [session u32]
  [language u32]
  [started bool]
  [pending i32]
  [answered bool]
  [replaying u32]
  [failed-starts u32]
  [history (ptr history-item)] [history-count u32] [history-capacity u32]
  [queue (ptr string)] [queued u32] [queue-at u32] [queue-capacity u32]
  [problem string]
  [worker-tag (ptr void)] [picking (ptr void)] [reading (ptr void)]
  [file-stream u32] [file buffer] [chunk (array u8 4096)])

(variant message
  [draft-changed [text string]]
  [draft-kept [text string]]
  [key-pressed [key string] [shift bool]]
  [run] [stop] [clear] [save] [load] [copy]
  [file-picked [kind u32] [value i32]]
  [file-read [kind u32] [value i32]]
  [use [language u32]]
  [worker-event [w u32] [kind u32]])

(variant repl-event [language-changed [language u32]])

;; ---- small helpers ----

(define (set-draft! [m (ptr model)] [s string])
  (let ([new (string-copy s)])
    (free (-> m draft bytes))
    (set! (-> m draft) new)
    (storage-set-text "repl-draft" new 0)))

(define (busy? [m (ptr model)]) -> bool (or (>= (-> m pending) 0) (> (-> m replaying) 0)))

;; ---- entries ----

(const max-output u32 200000)

(define (add-output! [e (ptr entry)] [b (slice u8)])
  (let ([out (& (-> e output))] [n (-> b length)])
    (cond [(-> e cut) (begin)]
          [(<= (+ (-> out length) n) max-output) (buffer-add! out b)]
          [else
           (set! (-> e cut) #t)
           (buffer-add! out (slice b 0 (- max-output (-> out length))))
           (buffer-add-string! out "\n... (more output not shown)")])))

(define (add-line! [e (ptr entry)] [s string])
  (let ([b (& (-> e output))])
    (when (and (> (-> b length) 0) (!= (@ (-> b bytes) (- (-> b length) 1)) #\newline)) (buffer-add-byte! b #\newline))
    (buffer-add-string! b s)))

(define (add-entry! [m (ptr model)] [input string]) -> u32
  (when (== (-> m count) (-> m capacity))
    (set! (-> m capacity) (if (== (-> m capacity) 0) 16 (* 2 (-> m capacity))))
    (set! (-> m entries) (cast (ptr entry) (realloc (-> m entries) (* (-> m capacity) (sizeof entry))))))
  (let ([e (+ (-> m entries) (-> m count))])
    (+= (-> m inputs) 1)
    (+= (-> m scroll) 1)
    (set! (-> e id) (-> m inputs))
    (set! (-> e input) (string-copy input))
    (set! (-> e output) (make-buffer))
    (set! (-> e failed) #f)
    (set! (-> e running) #f)
    (set! (-> e cut) #f)
    (+= (-> m count) 1)
    (- (-> m count) 1)))

(define (clear! [m (ptr model)])
  (for ([i u32 0]) (< i (-> m count)) (+= i 1)
    (free (-> (+ (-> m entries) i) input bytes))
    (buffer-free! (& (-> (+ (-> m entries) i) output))))
  (set! (-> m count) 0)
  (set! (-> m recalled) 0)
  (+= (-> m focus) 1))

;; ---- the session worker ----

(define (send-input! [m (ptr model)] [id u32] [input string])
  (let ([b (make-buffer)] [number (array u32 1)])
    (set! (@ number 0) id)
    (buffer-add! (& b) (slice (cast (ptr u8) number) 4))
    (buffer-add-string! (& b) input)
    (worker-send (-> m session) (buffer-bytes (& b)))
    (buffer-free! (& b))))

(define (remember! [m (ptr model)] [id u32] [input string])
  (when (== (-> m history-count) (-> m history-capacity))
    (set! (-> m history-capacity) (if (== (-> m history-capacity) 0) 16 (* 2 (-> m history-capacity))))
    (set! (-> m history)
          (cast (ptr history-item) (realloc (-> m history) (* (-> m history-capacity) (sizeof history-item))))))
  (let ([item (+ (-> m history) (-> m history-count))])
    (set! (-> item id) id)
    (set! (-> item input) (string-copy input))
    (+= (-> m history-count) 1)))

(define (forget-history! [m (ptr model)])
  (for ([i u32 0]) (< i (-> m history-count)) (+= i 1)
    (free (-> (+ (-> m history) i) input bytes)))
  (set! (-> m history-count) 0))

;; The session runs the compiler half on a worker.
(define (session-main) (session-serve!))

(define (worker-heard [source u32] [kind u32] [g u32] [tag (ptr void)] [value i32]) (send! (worker-event g kind)))

(define (start-worker! [m (ptr model)])
  (when (> (-> m problem length) 0) (free (-> m problem bytes)))
  (set! (-> m problem) "")
  (set! (-> m started) #f)
  (when (!= (-> m worker-tag) 0) (unsubscribe! (-> m worker-tag)))
  (set! (-> m worker-tag) (subscribe! worker-heard))
  (let ([o worker-options] [why error])
    (worker-options-init! (& o))
    (set! (-> o output) #t)
    (unless (worker-start session-main (cast (slice u8) "") (& o) (-> m worker-tag) (& (-> m session)) (& why))
      (set! (-> m problem) (error-text (& why)))
      (unsubscribe! (-> m worker-tag))
      (set! (-> m worker-tag) 0))))

(define (evaluate! [m (ptr model)] [input string])
  (let* ([i (add-entry! m input)] [e (+ (-> m entries) i)])
    (set! (-> e running) #t)
    (set! (-> m pending) (cast i32 i))
    (set! (-> m answered) #f)
    (send-input! m (-> e id) input)))

(define (language-input [language u32]) -> string
  (case language
    [(0) "(language scheme)"]
    [(1) "(language compiler/substrate)"]
    [(2) "(language bend2)"]
    [else ""]))

;; ---- inputs from a file ----

(define (queue! [m (ptr model)] [input string])
  (when (== (-> m queued) (-> m queue-capacity))
    (set! (-> m queue-capacity) (if (== (-> m queue-capacity) 0) 16 (* 2 (-> m queue-capacity))))
    (set! (-> m queue) (cast (ptr string) (realloc (-> m queue) (* (-> m queue-capacity) (sizeof string))))))
  (set! (@ (-> m queue) (-> m queued)) (string-copy input))
  (+= (-> m queued) 1))

(define (drop-queue! [m (ptr model)])
  (for ([i (-> m queue-at)]) (< i (-> m queued)) (+= i 1) (free (-> (@ (-> m queue) i) bytes)))
  (set! (-> m queued) 0)
  (set! (-> m queue-at) 0))

(define (evaluate-next! [m (ptr model)])
  (when (and (< (-> m queue-at) (-> m queued)) (not (busy? m)) (!= (-> m session) 0))
    (let ([input (@ (-> m queue) (-> m queue-at))])
      (+= (-> m queue-at) 1)
      (evaluate! m input)
      (free (-> input bytes)))
    (when (== (-> m queue-at) (-> m queued)) (drop-queue! m))))

(define (load-forms! [m (ptr model)] [text string])
  (let ([form (make-buffer)] [n (-> text length)] [start u32 0])
    (for ([i u32 0]) (<= i n) (+= i 1)
      (when (or (== i n) (== (@ text i) #\newline))
        (when (> (-> form length) 0) (buffer-add-byte! (& form) #\newline))
        (buffer-add-string! (& form) (slice text start i))
        (when (complete? (buffer-string (& form)))
          (queue! m (buffer-string (& form)))
          (set! (-> form length) 0))
        (set! start (+ i 1))))
    (buffer-free! (& form))
    (evaluate-next! m)))

(define (files-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (send! (file-picked kind value)))

(define (chunk-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (send! (file-read kind value)))

(define (picked! [m (ptr model)] [kind u32] [value i32])
  (if (== kind files-file)
      (let ([stream (cast u32 value)])
        (set! (-> m file-stream) stream)
        (set! (-> m file) (make-buffer))
        (set! (-> m reading) (subscribe! chunk-heard))
        (stream-tag! stream (-> m reading))
        (stream-read! stream (slice (-> m chunk))))
      (begin
        (unsubscribe! (-> m picking))
        (set! (-> m picking) 0))))

(define (read! [m (ptr model)] [kind u32] [value i32])
  (if (and (== kind stream-read) (> value 0))
      (begin
        (buffer-add! (& (-> m file)) (slice (-> m chunk) (cast u32 value)))
        (stream-read! (-> m file-stream) (slice (-> m chunk))))
      (begin
        (unsubscribe! (-> m reading))
        (set! (-> m reading) 0)
        (when (== kind stream-read) (load-forms! m (buffer-string (& (-> m file)))))
        (buffer-free! (& (-> m file))))))

;; ---- the session as text ----

(define (transcript [m (ptr model)] [outputs bool]) -> buffer
  (let ([b (make-buffer)])
    (for ([i u32 0]) (< i (-> m count)) (+= i 1)
      (let ([e (+ (-> m entries) i)])
        (when (> i 0) (buffer-add-byte! (& b) #\newline))
        (buffer-add-string! (& b) (-> e input))
        (buffer-add-byte! (& b) #\newline)
        (when (and outputs (> (-> e output length) 0))
          (buffer-add-string! (& b) ";; ")
          (for ([j u32 0]) (< j (-> e output length)) (+= j 1)
            (let ([c (@ (-> e output bytes) j)])
              (buffer-add-byte! (& b) c)
              (when (and (== c #\newline) (< (+ j 1) (-> e output length))) (buffer-add-string! (& b) ";; "))))
          (buffer-add-byte! (& b) #\newline))))
    b))

(define (save! [m (ptr model)])
  (let ([b (transcript m #f)])
    (files-save "session.sub" (buffer-bytes (& b)))
    (buffer-free! (& b))))

(define (copy! [m (ptr model)])
  (let ([b (transcript m #t)])
    (clipboard-write (buffer-string (& b)) 0 0 0)
    (buffer-free! (& b))))

(define (start-session! [m (ptr model)] [language u32])
  (when (!= (-> m session) 0) (worker-stop (-> m session)))
  (clear! m)
  (forget-history! m)
  (drop-queue! m)
  (set! (-> m language) language)
  (set! (-> m pending) -1)
  (set! (-> m replaying) 0)
  (set! (-> m failed-starts) 0)
  (start-worker! m)
  (let ([input (language-input language)])
    (when (and (!= input "") (!= (-> m session) 0)) (evaluate! m input)))
  (set! (-> m recalled) (-> m count)))

(define (restore-session! [m (ptr model)] [why string])
  (when (>= (-> m pending) 0)
    (unless (-> m answered)
      (let ([e (+ (-> m entries) (-> m pending))])
        (add-line! e why)
        (set! (-> e failed) #t)
        (set! (-> e running) #f)))
    (set! (-> m pending) -1)
    (+= (-> m scroll) 1))
  (set! (-> m replaying) 0)
  (+= (-> m failed-starts) 1)
  (if (> (-> m failed-starts) 2)
      (begin
        (set! (-> m session) 0)
        (when (> (-> m problem length) 0) (free (-> m problem bytes)))
        (set! (-> m problem) (string-copy why)))
      (begin
        (start-worker! m)
        (when (!= (-> m session) 0)
          (for ([i u32 0]) (< i (-> m history-count)) (+= i 1)
            (send-input! m (-> (+ (-> m history) i) id) (-> (+ (-> m history) i) input)))
          (set! (-> m replaying) (-> m history-count))))))

(define (finish-entry! [m (ptr model)])
  (let* ([e (+ (-> m entries) (-> m pending))] [reply (make-buffer)] [n (events-take! (& reply))] [out (& (-> e output))])
    (when (> n 1) (add-line! e (cast string (slice (buffer-bytes (& reply)) 1))))
    (set! (-> e failed) (and (> n 0) (!= (@ (-> reply bytes) 0) 0)))
    (set! (-> e running) #f)
    (when (and (> (-> out length) 0) (== (@ (-> out bytes) (- (-> out length) 1)) #\newline)) (-= (-> out length) 1))
    (unless (-> e failed) (remember! m (-> e id) (-> e input)))
    (buffer-free! (& reply))
    (set! (-> m answered) #t)
    (set! (-> m failed-starts) 0)
    (+= (-> m scroll) 1)))

(define (handle-worker-event! [m (ptr model)] [g u32] [kind u32])
  (when (and (== g (-> m session)) (!= g 0))
    (cond
      [(== kind worker-ended)
       (let* ([reason (events-take-text)]
              [why (if (== (-> reason length) 0) "The session ended." reason)]
              [failed (and (>= (-> m pending) 0) (not (-> m answered)))])
         (when failed (add-line! (+ (-> m entries) (-> m pending)) why))
         (restore-session! m (if failed "The session crashed while evaluating this input. A new session was started." why))
         (free (-> reason bytes)))]

      [(== kind worker-done)
       (cond [(not (-> m started)) (set! (-> m started) #t)]
             [(> (-> m replaying) 0)
              (-= (-> m replaying) 1)
              (when (== (-> m replaying) 0) (set! (-> m failed-starts) 0))]
             [(< (-> m pending) 0) (begin)]
             [(-> m answered)
              (set! (-> m pending) -1)
              (evaluate-next! m)]
             [else
              (let ([trap (events-take-text)])
                (when (> (-> trap length) 0) (add-line! (+ (-> m entries) (-> m pending)) trap))
                (free (-> trap bytes)))
              (worker-stop g)
              (restore-session! m "The session crashed while evaluating this input. A new session was started.")])]

      [(> (-> m replaying) 0) (begin)]

      [(or (< (-> m pending) 0) (-> m answered)) (begin)]

      [(== kind worker-message) (finish-entry! m)]

      [else
       (let ([printed (make-buffer)])
         (events-take! (& printed))
         (add-output! (+ (-> m entries) (-> m pending)) (buffer-bytes (& printed)))
         (buffer-free! (& printed))
         (+= (-> m scroll) 1))])))

;; ---- handling user actions ----

(define (complete? [s string]) -> bool
  (let ([n (-> s length)] [depth 0] [i u32 0] [some #f])
    (while (< i n)
      (let ([c (@ s i)])
        (cond [(== c #\;) (while (and (< i n) (!= (@ s i) #\newline)) (+= i 1)) (continue)]
              [(== c #\")
               (+= i 1)
               (while (and (< i n) (!= (@ s i) #\"))
                 (when (and (== (@ s i) #\\) (< (+ i 1) n)) (+= i 1))
                 (+= i 1))
               (when (>= i n) (return #f))
               (set! some #t)]
              [(and (== c #\#) (< (+ i 2) n) (== (@ s (+ i 1)) #\\)) (+= i 2) (set! some #t)]
              [(or (== c #\() (== c #\[)) (+= depth 1) (set! some #t)]
              [(or (== c #\)) (== c #\])) (-= depth 1)]
              [(> c #\space) (set! some #t)]))
      (+= i 1))
    (and some (<= depth 0))))

(define (one-line? [s string]) -> bool (== (string-index s #\newline) (-> s length)))

(define (submit! [m (ptr model)])
  (when (and (complete? (-> m draft)) (not (busy? m)) (!= (-> m session) 0))
    (evaluate! m (-> m draft))
    (set-draft! m ""))
  (set! (-> m recalled) (-> m count))
  (+= (-> m focus) 1))

(define (stop! [m (ptr model)])
  (drop-queue! m)
  (cond [(> (-> m replaying) 0) (start-session! m (-> m language))]
        [(>= (-> m pending) 0)
         (worker-stop (-> m session))
         (set! (-> m failed-starts) 0)
         (restore-session! m "Stopped.")])
  (+= (-> m focus) 1))

(define (recall! [m (ptr model)] [by i32])
  (let ([i (+ (cast i32 (-> m recalled)) by)])
    (when (and (>= i 0) (<= i (cast i32 (-> m count))))
      (set! (-> m recalled) (cast u32 i))
      (set-draft! m (if (== (cast u32 i) (-> m count)) "" (-> (+ (-> m entries) i) input))))))

(define (key! [m (ptr model)] [key string] [shift bool])
  (cond [(and (== key "Enter") (not shift) (complete? (-> m draft)))
         (prevent-default!)
         (submit! m)]
        [(and (== key "ArrowUp") (one-line? (-> m draft)))
         (prevent-default!)
         (recall! m -1)]
        [(and (== key "ArrowDown") (one-line? (-> m draft)))
         (prevent-default!)
         (recall! m 1)]))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(draft-changed text) (set-draft! m text)]
    [(draft-kept text) (set-draft! m text)]
    [(key-pressed key shift) (key! m key shift)]
    [run (submit! m)]
    [stop (stop! m)]
    [clear (unless (busy? m) (clear! m))]
    [save (save! m)]
    [load
     (when (== (-> m picking) 0) (set! (-> m picking) (subscribe! files-heard)))
     (files-pick #f "" (-> m picking) 0 0)]
    [(file-picked kind value) (picked! m kind value)]
    [(file-read kind value) (read! m kind value)]
    [copy (copy! m)]
    [(use language)
     (start-session! m language)
     (emit! (language-changed language))]
    [(worker-event g kind) (handle-worker-event! m g kind)]))

(define (trapped [m (ptr model)] [why string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "error: ")
    (buffer-add-string! (& b) why)
    (buffer-add-byte! (& b) #\newline)
    (host-write 2 (buffer-bytes (& b)))
    (buffer-free! (& b)))
  (+= (-> m focus) 1))

(define (draft-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== kind storage-got) (== value 1))
    (let ([text (events-take-text)])
      (send! (draft-kept text))
      (free (-> text bytes)))))

(define (init [m (ptr model)] [language u32])
  (set! (-> m draft) (string-copy ""))
  (storage-get "repl-draft" (request! draft-heard))
  (start-session! m language))

;; ---- what it looks like ----

(define style string
  ".repl { --ground: #fbfaf7; --ink: #1c1b18; --faint: #6b675e; --line: #dedad0; --input: #f1eee6; --accent: #2f5d50;
  --failed: #a3341f; --mono: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;
  display: flex; flex-direction: column; height: 100%; box-sizing: border-box;
  background: var(--ground); color: var(--ink); font: 15px/1.5 system-ui, sans-serif; }
@media (prefers-color-scheme: dark) {
  .repl { --ground: #171613; --ink: #e9e5da; --faint: #9a9588; --line: #34322c; --input: #211f1b; --accent: #8fc7b3;
          --failed: #f08c74; }
}
.repl * { box-sizing: border-box; }
.repl nav { display: flex; gap: 0.5rem; flex-wrap: wrap; padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); }
.repl button { font: inherit; color: var(--ink); background: transparent; border: 1px solid var(--line);
  border-radius: 4px; padding: 0.2rem 0.7rem; cursor: pointer; }
.repl button:hover { border-color: var(--accent); color: var(--accent); }
.repl button:disabled { color: var(--faint); border-color: var(--line); cursor: default; opacity: 0.6; }
.repl button.stop { border-color: var(--failed); color: var(--failed); }
.repl button.quiet { margin-left: auto; color: var(--faint); }
.repl main { flex: 1; overflow-y: auto; padding: 0.75rem 0; }
.repl section.entry { padding: 0.35rem 0 0.35rem 0.75rem; border-left: 2px solid var(--line); margin: 0.5rem 0; }
.repl section.entry.failed { border-left-color: var(--failed); }
.repl section.entry.running { border-left-color: var(--accent); animation: repl-running 1.2s ease-in-out infinite; }
@keyframes repl-running { 50% { border-left-color: var(--line); } }
@media (prefers-reduced-motion: reduce) { .repl section.entry.running { animation: none; } }
.repl p.status { margin: 0.5rem 0; color: var(--faint); font-size: 0.9rem; }
.repl p.problem { color: var(--failed); }
.repl pre { font: 13.5px/1.5 var(--mono); margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
.repl pre.input { color: var(--accent); }
.repl pre.output { margin-top: 0.15rem; }
.repl .failed pre.output { color: var(--failed); }
.repl footer { display: flex; gap: 0.5rem; align-items: flex-end; padding: 0.75rem 0 0; border-top: 1px solid var(--line); }
.repl textarea { flex: 1; font: 13.5px/1.5 var(--mono); color: var(--ink); background: var(--input);
  border: 1px solid var(--line); border-radius: 4px; padding: 0.5rem 0.6rem; resize: vertical; }
.repl textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; }")

(view (entry-view [e (ptr entry)])
  (section ([class (if (-> e running) "entry running" (if (-> e failed) "entry failed" "entry"))])
    (pre ([class "input"]) (text (-> e input)))
    (when (> (-> e output length) 0) (pre ([class "output"]) (text (buffer-string (& (-> e output))))))))

(component (repl [language u32])
  #:state [m model]
  #:messages message
  #:update update
  #:init init
  #:events repl-event
  #:trapped trapped
  #:style style
  (div ([class "repl"])
    (nav
      (button ([on click (use 0)]) "Scheme")
      (button ([on click (use 1)]) "Substrate")
      (button ([on click (use 2)]) "Bend")
      (button ([class "quiet"] [disabled (busy? m)] [on click clear]) "clear")
      (button ([class "quiet"] [on click save]) "save")
      (button ([class "quiet"] [disabled (busy? m)] [on click load]) "load")
      (button ([class "quiet"] [on click copy]) "copy"))
    (main ([scroll-end (-> m scroll)])
      (each [e (-> m entries) (-> m count)] #:key (-> e id) (entry-view e))
      (when (> (-> m replaying) 0) (p ([class "status"]) "Restoring the session: running the earlier inputs again..."))
      (when (!= (-> m problem) "") (p ([class "status problem"]) "No session could be started: " (text (-> m problem)))))
    (footer
      (textarea ([value (-> m draft)] [rows 3] [spellcheck "false"] [autocapitalize "off"] [autofocus]
                 [placeholder "(define (sq x) (* x x))    Enter to evaluate, Shift+Enter for a new line"]
                 [on input (draft-changed (event value))] [on keydown (key-pressed (event key) (event shift))]
                 [focus (-> m focus)]))
      (if (busy? m)
          (button ([class "stop"] [on click stop]) "stop")
          (button ([on click run]) "run")))))
