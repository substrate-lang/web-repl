;; Tests that use the examples as a user would, in Chromium.
(require-unqualified std/test/browser)
(require-unqualified std/test/test)

(define (entry [n u32]) -> finder (nth (by-css "section.entry") n))

(define (output [n u32]) -> finder (within (entry n) (by-css ".output")))

(define (idle [b browser]) (expect-missing b (by-css "section.running, p.status, button.stop")))

(define (said [b browser] [input string])
  (browser-type! b (by-css "textarea") input)
  (browser-press! b "Enter")
  (idle b))

(test repl
  (with-browser (b "repl")
    (idle b)
    (expect-text b (within (entry 1) (by-css ".input")) "(language scheme)")
    (expect-count b (by-css "textarea:focus") 1)
    (said b "(define (sq x) (* x x))")
    (said b "(sq 7)")
    (expect-text b (output 3) "49")
    (said b "(car 5)")
    (expect-attribute b (entry 4) "class" "entry failed")
    (expect-count b (within (entry 4) (by-text-containing "error: car: expected a pair, got 5")) 1)
    (browser-type! b (by-css "textarea") "(map sq")
    (browser-press! b "Enter")
    (said b "     '(1 2 3))")
    (expect-text b (within (entry 5) (by-css ".input")) "(map sq\n     '(1 2 3))")
    (expect-text b (output 5) "(1 4 9)")
    (said b "(nope)")
    (expect-count b (within (entry 6) (by-text-containing "error: unbound identifier nope")) 1)
    (said b "(define (sq x) (* x x x))")
    (said b "(sq 3)")
    (expect-text b (output 8) "27")
    (expect-value b (by-css "textarea") "")
    (browser-press! b "ArrowUp")
    (expect-value b (by-css "textarea") "(sq 3)")
    (browser-press! b "ArrowUp")
    (browser-press! b "ArrowDown")
    (browser-press! b "Enter")
    (idle b)
    (expect-text b (output 9) "27")))

(test repl-stop
  (with-browser (b "repl")
    (idle b)
    (said b "(define (sq x) (* x x x))")
    (browser-type! b (by-css "textarea") "(let loop () (loop))")
    (browser-press! b "Enter")
    (expect-count b (by-css "button.stop") 1)
    (expect-attribute b (entry 3) "class" "entry running")
    (browser-type! b (by-css "textarea") "(sq 5)")
    (browser-press! b "Enter")
    (expect-value b (by-css "textarea") "(sq 5)")
    (expect-attribute b (by-role "button" "clear") "disabled" "")
    (browser-click! b (by-css "button.stop"))
    (idle b)
    (expect-text b (output 3) "Stopped.")
    (browser-press! b "Enter")
    (idle b)
    (expect-text b (output 4) "125")
    (browser-type! b (by-css "textarea") "(let loop ([n 0]) (display n) (newline) (loop (+ n 1)))")
    (browser-press! b "Enter")
    (expect-count b (within (entry 5) (by-text-containing "... (more output not shown)")) 1)
    (browser-click! b (by-css "button.stop"))
    (idle b)
    (expect-count b (within (entry 5) (by-text-containing "Stopped.")) 1)))

(test repl-substrate
  (with-browser (b "repl")
    (idle b)
    (browser-click! b (by-role "button" "Substrate"))
    (idle b)
    (expect-text b (within (entry 1) (by-css ".input")) "(language compiler/substrate)")
    (expect-count b (by-css "textarea:focus") 1)
    (said b "(define (fib [n i32]) -> i32 (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))")
    (said b "(+ (fib 20) 0.5)")
    (expect-text b (output 3) "6765.5")
    (said b "(memset (cast (ptr void) 8) 255 (cast u32 (- (sbrk 0) 8)))")
    (expect-count b (by-text-containing "The session crashed while evaluating this input. A new session was started.") 1)
    (said b "(fib 10)")
    (expect-text b (output 5) "55")
    (browser-click! b (by-role "button" "clear"))
    (expect-missing b (by-css "section.entry"))
    (said b "(fib 11)")
    (expect-text b (output 1) "89")
    (said b "(begin-for-syntax (define (trapping [s i32]) -> i32 (/ s 0)))")
    (said b "(define-syntax trap! trapping)")
    (said b "(trap! 1)")
    (expect-attribute b (entry 4) "class" "entry failed")
    (expect-count b (within (entry 4) (by-text-containing "error: trap: divide by zero")) 1)
    (said b "(fib 12)")
    (expect-text b (output 5) "144")
    (said b "(begin-for-syntax (require-unqualified compiler/macros))")
    (expect-attribute b (entry 6) "class" "entry")
    (browser-click! b (by-role "button" "Bend"))
    (idle b)
    (expect-equal (browser-url b) "http://localhost/index.html?language=bend")
    (browser-go! b "?language=substrate")
    (idle b)
    (expect-text b (within (entry 1) (by-css ".input")) "(language compiler/substrate)")))

(test repl-files
  (with-browser (b "repl" #:url "?language=substrate")
    (idle b)
    (said b "(define (sq [x i32]) -> i32 (* x x))")
    (said b "(sq 4)")
    (browser-click! b (by-role "button" "save"))
    (expect-equal (browser-downloaded b "session.sub")
                  "(language compiler/substrate)\n\n(define (sq [x i32]) -> i32 (* x x))\n\n(sq 4)\n")
    (browser-click! b (by-role "button" "copy"))
    (expect-equal (browser-clipboard-get b)
                  "(language compiler/substrate)\n\n(define (sq [x i32]) -> i32 (* x x))\n\n(sq 4)\n;; 16\n")
    (browser-choose-files! b "repl/forms.sub")
    (browser-click! b (by-role "button" "load"))
    (idle b)
    (expect-text b (within (entry 4) (by-css ".input")) "(define (cube [x i32]) -> i32\n  (* x x x))")
    (expect-text b (output 5) "27")
    (browser-type! b (by-css "textarea") "(sq 1")
    (browser-advance! b 1000)
    (browser-reload! b)
    (idle b)
    (expect-value b (by-css "textarea") "(sq 1")
    (expect-text b (within (entry 1) (by-css ".input")) "(language compiler/substrate)")))

(test repl-bend
  (with-browser (b "repl" #:url "?language=bend")
    (idle b)
    (expect-text b (within (entry 1) (by-css ".input")) "(language bend2)")
    (said b "(def (double [+ n : Nat]) Nat (Nat.add n n))")
    (said b "(print (double (nat 21)))")
    (expect-text b (output 3) "(nat 42)")
    (said b "(def (sum [xs : (List Nat)] [acc : Nat]) Nat (match xs [Nil acc] [(Con h t) (sum t (Nat.add h acc))]))")
    (said b "(print (sum (Con (nat 1) (Con (nat 2) (Con (nat 3) Nil))) Zero))")
    (expect-text b (output 5) "(nat 6)")
    (said b "(def (twice [n : Nat]) Nat (Nat.add n n))")
    (expect-attribute b (entry 6) "class" "entry failed")
    (expect-count b (within (entry 6) (by-text-containing "observed n (consumed more than once)")) 1)
    (said b "(print (double True))")
    (expect-attribute b (entry 7) "class" "entry failed")
    (expect-count b (within (entry 7) (by-text-containing "observed Bool")) 1)
    (said b "(print (twice (nat 1)))")
    (expect-count b (within (entry 8) (by-text-containing "twice is not a variable or a definition of Bend")) 1)
    (said b "(print (double (nat 4)))")
    (expect-text b (output 9) "(nat 8)")))
