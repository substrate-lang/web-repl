;; The REPL web page: the compiler half, which the page runs as a worker. Each input comes as a message, an id in
;; four bytes and the text; the answer is a byte, 1 when it failed, and then the error.
(require-unqualified macros "../../../compiler/macros.sub")
(require-unqualified ex "../../../compiler/expander.sub")
(require-unqualified worker "../../../host/worker.sub")
(require-unqualified events "../../../host/events.sub")

(provide session-serve!)

(define input buffer)

(define evaluating i32 0)

(define (session-serve!)
  (set! input (make-buffer))
  (event-handler! worker-source on-message)
  (trap-handler! session-trapped)
  (set-repository-root! `"/src")
  (set-package-root! `"/src")
  (install-core!)
  (session-open! `"repl"))

(define (reply! [failed i32] [error datum])
  (let ([b (make-buffer)])
    (buffer-add-byte! (& b) failed)
    (when (!= error 0) (buffer-add! (& b) (string-bytes error) (string-length error)))
    (worker-send 0 (-> b bytes) (-> b length))
    (buffer-free! (& b))))

(define (on-message [s u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message)
    (set! (-> input length) 0)
    (when (>= (events-take! (& input)) 4)
      (let* ([id (@ (cast (ptr u32) (-> input bytes)))]
             [source (format-message "input-~a" (cons (make-integer id) nil))]
             [text (bytes->string (+ (-> input bytes) 4) (- (-> input length) 4))])
        (set! evaluating 1)
        (let ([succeeded (session-eval-text! text source)])
          (set! evaluating 0)
          (reply! (not succeeded) (if succeeded 0 (session-error))))))))

(define (session-trapped)
  (when evaluating
    (set! evaluating 0)
    (reply! 1 (trap-report))
    (session-recover!)))
